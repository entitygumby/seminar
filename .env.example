# Vercel Postgres (auto-populated when you link a Vercel Postgres database)
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# Admin password for viewing registrations
ADMIN_PASSWORD=changeme

# Set to "true" to use in-memory storage (for local dev without a database)
USE_MEMORY_STORE=true

# Vercel Blob (auto-populated when you link a Blob store) — stores Book of Memories photos.
# Without it, uploaded photos are kept in memory for local development only.
BLOB_READ_WRITE_TOKEN=
